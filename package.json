{
  "name": "meidiantong-workbench",
  "private": true,
  "version": "0.1.0",
  "description": "Media Advertising Workbench (Electron + React 18 + TS)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron:dev": "vite build && tsc -p electron && electron .",
    "electron:main": "tsc -p tsconfig.electron.json"
  },
  "dependencies": {
    "fake-indexeddb": "^6.2.5",
    "idb": "^8.0.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
